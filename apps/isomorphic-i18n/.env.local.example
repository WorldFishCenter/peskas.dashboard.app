NEXT_PUBLIC_GOOGLE_MAP_API_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ASKFISH INTEGRATION: Public iframe URL used by the dashboard browser to open AskFish.
NEXT_PUBLIC_ASKFISH_URL=http://127.0.0.1:8000/embedded/
# ASKFISH INTEGRATION: Server-to-server bearer token for the current Peskas↔AskFish private routes.
# Keep the real value only in .env.local / deployment secrets; never commit it.
ASKFISH_SERVICE_TOKEN=
