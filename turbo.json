{
  "$schema": "https://v2-8-10.turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"],
      "env": [
        "ASKFISH_SHARED_TOKEN",
        "ASKFISH_SERVICE_TOKEN",
        "ASKFISH_BACKEND_TOKEN",
        "ASKFISH_URL",
        "MONGODB_URI",
        "MONGODB_URI_COASTS",
        "VERCEL",
        "VITE_COUNTRY_CODE",
        "VITE_GA_MEASUREMENT_ID",
        "VITE_GA_ROLLUP_ID",
        "VITE_MAPBOX_TOKEN"
      ]
    },
    "lint": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "dependsOn": ["^clean"]
    }
  },
  "ui": "stream",
  "globalEnv": [
    "ASKFISH_SHARED_TOKEN",
    "ASKFISH_SERVICE_TOKEN",
    "ASKFISH_BACKEND_TOKEN",
    "ASKFISH_URL",
    "MONGODB_URI",
    "MONGODB_URI_COASTS",
    "VERCEL",
    "VITE_COUNTRY_CODE",
    "VITE_GA_MEASUREMENT_ID",
    "VITE_GA_ROLLUP_ID",
    "VITE_MAPBOX_TOKEN"
  ]
}
