# Local development — copy to .env and fill in real values.
# VITE_* values are public (inlined into the browser bundle); the rest stay on the server.

VITE_COUNTRY_CODE=TZ
VITE_MAPBOX_TOKEN=
VITE_GA_MEASUREMENT_ID=
VITE_GA_ROLLUP_ID=

MONGODB_URI=
MONGODB_URI_COASTS=

# AskFish (optional, both server only). Left unset, the dashboard shows no AskFish.
# Where the AskFish service runs; the dashboard's server calls it, the browser never does:
ASKFISH_URL=
# The secret AskFish and the dashboards share: sent to AskFish, and checked when AskFish reads
# the data from /api/askfish. The same value on AskFish and every country (keep it out of git):
ASKFISH_SHARED_TOKEN=
