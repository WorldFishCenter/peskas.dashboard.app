{
  "name": "peskas-dashboard",
  "version": "7.0.0",
  "description": "Multi-country fisheries monitoring dashboard for the Peskas platform",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "lint": "turbo lint",
    "build": "turbo build",
    "start": "turbo start",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "i18n:dev": "turbo dev --filter=i18n",
    "i18n:lint": "turbo lint --filter=i18n",
    "i18n:build": "turbo build --filter=i18n",
    "i18n:start": "turbo start --filter=i18n",
    "i18n:clean": "turbo clean --filter=i18n"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "rimraf": "^5.0.5",
    "turbo": "2.10.9"
  },
  "pnpm": {
    "overrides": {
      "next": "15.5.23",
      "sharp": "^0.35.3",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.26",
      "braces": "^3.0.3",
      "brace-expansion@^1.0.0": "^1.1.18",
      "brace-expansion@^2.0.0": "^2.1.4",
      "micromatch": "^4.0.8",
      "js-yaml": "^4.3.1",
      "cookie": "^0.7.2",
      "tmp": "^0.2.7",
      "flatted": "^3.4.4",
      "lodash": "^4.18.1",
      "minimatch@^3.0.0": "^3.1.5",
      "minimatch@^9.0.0": "^9.0.9",
      "glob@^10.0.0": "^10.5.0",
      "picomatch@^2.0.0": "^2.3.2",
      "ip-address": "^10.5.0",
      "cross-spawn": "^7.0.6",
      "@babel/core": "^7.29.6",
      "@babel/runtime": "^7.29.6",
      "qs": "^6.14.1",
      "nodemailer": "^9.0.5",
      "ajv@^6.0.0": "^6.14.0",
      "yaml": "^2.8.3",
      "protocol-buffers-schema": "^3.6.1",
      "diff": "^4.0.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "nodemailer": "9"
      }
    }
  },
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": ">=18"
  }
}
